# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                          CheapRoute — Environment Config                    │
# │  Single source of truth for runtime configuration & environment variables.   │
# │  Both .env and .env.example stay synchronized with this clean structure.    │
# └─────────────────────────────────────────────────────────────────────────────┘

# ═══════════════════════════════════════════════════════════════════════════════
# 1. REQUIRED SECURITY SECRETS
# ═══════════════════════════════════════════════════════════════════════════════
# JWT secret for signing dashboard session cookies.
JWT_SECRET=

# Encryption key for API keys stored in SQLite database.
API_KEY_SECRET=

# Initial dashboard administrator password.
INITIAL_PASSWORD=klkl

# Storage encryption for sensitive credentials at rest.
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# ═══════════════════════════════════════════════════════════════════════════════
# 2. SERVER, PORTS & RUNTIME
# ═══════════════════════════════════════════════════════════════════════════════
PORT=20128
NODE_ENV=production
CHEAPROUTE_USE_TURBOPACK=1
CONTAINER_HOST=docker
MACHINE_ID_SALT=endpoint-proxy-salt

# Security controls
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
ALLOW_API_KEY_REVEAL=false

# ═══════════════════════════════════════════════════════════════════════════════
# 3. DOMAINS, ENDPOINTS & BASE URLS
# ═══════════════════════════════════════════════════════════════════════════════
# Dashboard UI Base URL
BASE_URL=https://router.tokendeal.cloud
NEXT_PUBLIC_BASE_URL=https://router.tokendeal.cloud
NEXT_PUBLIC_APP_NAME=CheapRouter

# Dedicated API Subdomain for all API/CRUD operations
NEXT_PUBLIC_API_BASE_URL=https://api.tokendeal.cloud
CHEAPROUTE_API_BASE_URL=https://api.tokendeal.cloud

# ═══════════════════════════════════════════════════════════════════════════════
# 4. CORS & ALLOWED ORIGINS
# ═══════════════════════════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=https://router.tokendeal.cloud,https://api.tokendeal.cloud,http://localhost:20128
CHEAPROUTE_ALLOWED_DEV_ORIGINS=router.tokendeal.cloud,api.tokendeal.cloud,201.18.218.29
CHEAPROUTE_ALLOW_ALL_DEV_ORIGINS=1

# ═══════════════════════════════════════════════════════════════════════════════
# 5. CUSTOM STATUS CODE ERROR MESSAGES
# ═══════════════════════════════════════════════════════════════════════════════
# Customize client-facing error responses for HTTP status codes.
# Supports dynamic placeholders in curly braces:
#   {error}    - The underlying sanitized error message from upstream / router
#   {provider} - The provider name (e.g. OpenAI, Anthropic, Groq) if available
#   {model}    - The model name requested (e.g. gpt-4o, claude-3-7-sonnet) if available
#   {code}     - The HTTP status code number (e.g. 429, 500)
#   {status}   - Alias for {code}
#
# Usage Guidelines:
#   1. To show provider and model:
#      STATUS_CODE_MESSAGE_429="Rate limit reached for {provider} on {model}: {error}"
#   2. To hide provider and model (cleaner public response):
#      STATUS_CODE_MESSAGE_429="Rate limit exceeded. Please wait a moment before retrying: {error}"
#   3. To hide the raw error completely:
#      STATUS_CODE_MESSAGE_429="Rate limit exceeded. Please retry in a few moments."
#   4. Fallback: If any variable is commented out or empty, it automatically falls back
#      to the built-in default message via null coalescing.

STATUS_CODE_MESSAGE_400="Bad request: {error}"
STATUS_CODE_MESSAGE_401="Authentication failed. Please verify your API key: {error}"
STATUS_CODE_MESSAGE_403="Access forbidden. You do not have permission to access this resource: {error}"
STATUS_CODE_MESSAGE_404="Model or resource not found ({model}): {error}"
STATUS_CODE_MESSAGE_408="Request timeout. The upstream service took too long to respond."
STATUS_CODE_MESSAGE_413="Payload too large. Prompt exceeds context window: {error}"
STATUS_CODE_MESSAGE_422="Unprocessable entity. Invalid request parameters: {error}"
STATUS_CODE_MESSAGE_429="Rate limit exceeded. Please wait a moment before retrying: {error}"
STATUS_CODE_MESSAGE_500="Internal server error while processing request: {error}"
STATUS_CODE_MESSAGE_502="Bad gateway. Upstream provider {provider} encountered an error: {error}"
STATUS_CODE_MESSAGE_503="Service temporarily unavailable. Upstream provider is overloaded: {error}"
STATUS_CODE_MESSAGE_504="Gateway timeout. Upstream provider {provider} timed out."

# ═══════════════════════════════════════════════════════════════════════════════
# 6. LOGGING & DIAGNOSTICS
# ═══════════════════════════════════════════════════════════════════════════════
APP_LOG_LEVEL=warn
APP_LOG_TO_FILE=true
QUOTA_STORE_DRIVER=sqlite
DISABLE_SQLITE_AUTO_BACKUP=false

# ═══════════════════════════════════════════════════════════════════════════════
# 7. PROXIES & NETWORKING
# ═══════════════════════════════════════════════════════════════════════════════
ENABLE_SOCKS5_PROXY=true
NEXT_PUBLIC_ENABLE_SOCKS5_PROXY=true
INSPECTOR_BUFFER_SIZE=1000
INSPECTOR_HTTP_PROXY_PORT=8080
INSPECTOR_HTTP_PROXY_AUTOSTART=false
INSPECTOR_TLS_INTERCEPT=false
INSPECTOR_MASK_SECRETS=true

# ═══════════════════════════════════════════════════════════════════════════════
# 8. OAUTH CLIENT CREDENTIALS (PUBLIC EMBEDDED IDENTIFIERS)
# ═══════════════════════════════════════════════════════════════════════════════
CLAUDE_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
KIMI_CODING_OAUTH_CLIENT_ID=17e5f671-d194-4dfb-9706-5516cb48c098
GITHUB_OAUTH_CLIENT_ID=Iv1.b507a08c87ecfe98

# Client User Agents
GITHUB_USER_AGENT="GitHubCopilotChat/0.54.0"
ANTIGRAVITY_USER_AGENT="antigravity/2.0.1 linux/arm64 google-api-nodejs-client/10.3.0"
KIRO_USER_AGENT="AWS-SDK-JS/3.0.0 kiro-ide/1.0.0"
QODER_USER_AGENT="Qoder-Cli"
CURSOR_USER_AGENT="Cursor/3.4"

