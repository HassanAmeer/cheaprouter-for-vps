  "author": "diegosouzapw",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegosouzapw/CheapRoute"
  },
  "homepage": "https://cheaproute.online",
  "scripts": {
    "dev": "node --max-old-space-size=3072 scripts/dev/run-next.mjs dev",
