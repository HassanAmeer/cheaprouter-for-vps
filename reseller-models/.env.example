# CheapRouter gateway base URL (no trailing slash)
CHEAPROUTE_URL=http://localhost:20128
# Management token for CheapRouter programmatic APIs (POST /api/keys, reseller users).
# Must match the token CheapRouter's requireManagementAuth accepts.
CHEAPROUTE_ADMIN_TOKEN=change-me
# 32+ byte secret for encrypting stored BYOK keys (AES-256-GCM) + signing sessions.
# Generate: openssl rand -hex 32
RESELLER_KEY_SECRET=change-me-generate-with-openssl-rand-hex-32
# SQLite file (defaults to ./data/reseller.db)
RESELLER_DB_PATH=./data/reseller.db
# Admin account bootstrap/rotation. If set, the admin password is (re)set to this
# value on every boot — use once to rotate away from any legacy default, then remove or keep it deliberately.
# If unset on a FRESH install, a random one-time password is generated and printed to the log instead.
# RESELLER_ADMIN_PASSWORD=
# Demo users (user1@gmail.com / user2@gmail.com) are seeded ONLY when true:
# RESELLER_SEED_DEMO_USERS=false
# Shared password for the demo users (random per-user password is printed instead if unset):
# RESELLER_DEMO_PASSWORD=
